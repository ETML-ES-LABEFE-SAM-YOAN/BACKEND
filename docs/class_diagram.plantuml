@startuml

package "Lot" {
    class LotController {
        + getLot(id: Long): LotDetailDTO
        + getLotsByCategoriePrincipale(nom: String): ResponseEntity<List<LotDetailDTO>>
        + getLotsBySousCategorie(nom: String): ResponseEntity<List<LotDetailDTO>>
        + createLot(dto: LotCreateDTO): ResponseEntity<LotDetailDTO>
    }

    class LotService {
        + getLot(id: Long): LotDetailDTO
        + getLotsByCategoriePrincipale(nom: String): List<LotDetailDTO>
        + getLotsBySousCategorie(nom: String): List<LotDetailDTO>
        + createLot(dto: LotCreateDTO): LotDetailDTO
    }

    class LotRepository {
        + findById(id: Long): Optional<LotEntity>
        + findByCategorieIn(categories: List<CategorieEntity>): List<LotEntity>
        + findByCategorie(categorie: CategorieEntity): List<LotEntity>
        + save(lot: LotEntity): LotEntity
    }

    class LotEntity {
        - id_lot: Long
        - nom_article: String
        - details: String
        - statut : Enum
        - enchere: Double
        - date_heure_fin: Date
        - description: String
        - image: String
        - categorie: CategorieEntity
        - utilisateur: UtilisateurEntity
    }

    class LotCreateDTO {
        - nom_article: String
        - details: String
        - enchere: Double
        - date_heure_fin: Date
        - description: String
        - image: String
        - idCategorie: Long
        - nomUtilisateur: String
    }

    class LotDetailDTO {
        - id: Long
        - nom_article: String
        - details: String
        - enchere: Double
        - date_heure_fin: Date
        - description: String
        - image: String
        - utilisateur: String
    }

    class LotNotFoundAdvice
    class LotNotFoundException

    LotController --> LotService
    LotService --> LotRepository
    LotService ..> LotCreateDTO
    LotService ..> LotDetailDTO
    LotRepository --> LotEntity
    LotNotFoundAdvice ..> LotNotFoundException
    LotController ..> LotNotFoundException
}

package "Utilisateur" {
    class UtilisateurController {
        + creerUtilisateur(dto: UtilisateurDTO): ResponseEntity<UtilisateurEntity>
    }

    class UtilisateurService {
        + creerUtilisateur(dto: UtilisateurDTO): UtilisateurEntity
    }

    class UtilisateurRepository {
        + findByNomUtilisateur(nom: String): Optional<UtilisateurEntity>
        + findByEmail(email: String): Optional<UtilisateurEntity>
        + save(entity: UtilisateurEntity): UtilisateurEntity
    }

    class UtilisateurEntity {
        - nomUtilisateur: String
        - nom: String
        - prenom: String
        - email: String
        - motDePasse: String
        - telephone: String
        - rue: String
        - npa: String
        - localite: String
        - solde: Double
        - dateCreation: Date
    }

    class UtilisateurDTO {
        - nomUtilisateur: String
        - nom: String
        - prenom: String
        - email: String
        - motDePasse: String
        - telephone: String
        - rue: String
        - npa: String
        - localite: String
    }

    class GlobalExceptionHandler
    class PasswordInvalidException
    class UserAlreadyExistsException
    class UtilisateurNotFoundException

    UtilisateurController --> UtilisateurService
    UtilisateurService --> UtilisateurRepository
    UtilisateurService ..> UtilisateurDTO
    UtilisateurRepository --> UtilisateurEntity
    GlobalExceptionHandler ..> UtilisateurController
    PasswordInvalidException ..> GlobalExceptionHandler
    UserAlreadyExistsException ..> GlobalExceptionHandler
    UtilisateurNotFoundException ..> GlobalExceptionHandler
}

package "Categorie" {
    class CategorieController {
        + getCategoriesPrincipales(): ResponseEntity<List<CategorieDTO>>
        + getCategorieTreeByNom(nom: String): ResponseEntity<CategorieDTO>
    }

    class CategorieService {
        + getCategoriesPrincipales(): List<CategorieDTO>
        + getCategorieTreeByNom(nom: String): CategorieDTO
        + toDto(entity: CategorieEntity): CategorieDTO
    }

    class CategorieRepository {
        + findByNom(nom: String): Optional<CategorieEntity>
        + findByParentIsNull(): List<CategorieEntity>
    }

    class CategorieEntity {
        - id_categorie: Long
        - nom: String
        - parent: CategorieEntity
        - sousCategories: List<CategorieEntity>
    }

    class CategorieDTO {
        - id_categorie: Long
        - nom: String
        - sousCategories: List<CategorieDTO>
    }

    class CategorieNotFoundAdvice
    class CategorieNotFoundException

    CategorieController --> CategorieService
    CategorieService --> CategorieRepository
    CategorieService ..> CategorieDTO
    CategorieService ..> CategorieEntity
    CategorieRepository --> CategorieEntity
    CategorieEntity "1" --> "0..*" CategorieEntity : parent
    CategorieDTO o-- "0..*" CategorieDTO : sousCategories
    CategorieNotFoundAdvice ..> CategorieNotFoundException
    CategorieController ..> CategorieNotFoundException
}

package "Enchere" {
        class EnchereDto {
            - lotId: Long
            - montant: Double
            - nomUtilisateur: String
        }
        class EnchereResponseDto {
            - id: Long
            - montant: Double
            - dateEnchere: Date
            - nomUtilisateur: String
            - lotId: Long
        }

    class EnchereController {
        + placerEnchere(dto: EnchereDto): ResponseEntity<EnchereResponseDto>
        + getEncheresPourLot(lotId: Long): ResponseEntity<List<EnchereResponseDto>>
        + getMeilleureEncherePourLot(lotId: Long): ResponseEntity<EnchereResponseDto>
        + getEncheresPourUtilisateur(nomUtilisateur: String): ResponseEntity<List<EnchereResponseDto>>
    }

    class EnchereService {
        + placerEnchere(lotId: Long, nomUtilisateur: String, montant: Double): EnchereEntity
        + getEncheresPourLot(lotId: Long): List<EnchereEntity>
        + getMeilleureEncherePourLot(lotId: Long): EnchereEntity
        + getEncheresPourUtilisateur(nomUtilisateur: String): List<EnchereEntity>
        + toDto(entity: EnchereEntity): EnchereResponseDto
    }

    class EnchereRepository {
        + findByLotOrderByMontantDesc(lot: LotEntity): List<EnchereEntity>
        + findTopByLotOrderByMontantDesc(lot: LotEntity): Optional<EnchereEntity>
        + findByUtilisateurOrderByDateEnchereDesc(utilisateur: UtilisateurEntity): List<EnchereEntity>
    }

    class EnchereEntity {
        - id: Long
        - utilisateur: UtilisateurEntity
        - lot: LotEntity
        - montant: Double
        - dateEnchere: Date
    }

    class EnchereMontantInvalideException
    class SoldeInsuffisantException
    class GlobalExceptionHandlerEnchere

    EnchereController --> EnchereService
    EnchereService --> EnchereRepository
    EnchereService ..> EnchereDto
    EnchereService ..> EnchereResponseDto
    EnchereRepository --> EnchereEntity
    EnchereEntity --> LotEntity
    EnchereEntity --> UtilisateurEntity
    GlobalExceptionHandlerEnchere ..> EnchereMontantInvalideException
    GlobalExceptionHandlerEnchere ..> SoldeInsuffisantException
    GlobalExceptionHandlerEnchere ..> EnchereController

}

LotEntity }o--|| CategorieEntity : appartient à
LotEntity --> UtilisateurEntity : "créé par"
LotService --> CategorieRepository

@enduml
